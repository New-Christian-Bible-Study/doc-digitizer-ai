# Copy this file to `secrets.env` and fill in real values before running.
# DO NOT commit your real `secrets.env` to version control.

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_SYSTEM_PROMPT=src/prompts/gemini_system.txt
GEMINI_USER_PROMPT=src/prompts/gemini_user.txt
