{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IDP Pass 1 Line Transcription (VLM only)",
  "description": "Structured output from the vision-language model before PaddleOCR line boxes are applied. anchor_box_2d is a coarse hint for matching only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["lines", "confidence_score", "confidence_label"],
  "properties": {
    "lines": {
      "type": "array",
      "description": "One object per visible text line in reading order",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page_number", "text", "anchor_box_2d", "ai_confidence_label", "ai_notes"],
        "properties": {
          "page_number": {
            "type": "integer",
            "minimum": 1,
            "description": "1-based page index within this chunk"
          },
          "text": {
            "type": "string",
            "description": "Transcription for this line"
          },
          "anchor_box_2d": {
            "type": "array",
            "description": "Coarse [ymin, xmin, ymax, xmax] normalized 0-1000 for layout matching; replaced on disk by Paddle line_box",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "minItems": 4,
            "maxItems": 4
          },
          "ai_confidence_label": {
            "type": "string",
            "enum": ["low", "medium", "high"],
            "description": "AI per-line confidence level for triage"
          },
          "ai_notes": {
            "type": "string",
            "description": "AI per-line rationale for uncertainty; required when AI confidence is low"
          }
        }
      }
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Numeric confidence in the transcription (0.0 to 1.0)"
    },
    "confidence_label": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "description": "Human-readable confidence level"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lines": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {
                "ai_confidence_label": {
                  "const": "low"
                }
              },
              "required": ["ai_confidence_label"]
            }
          }
        }
      },
      "then": {
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "if": {
                "properties": {
                  "ai_confidence_label": {
                    "const": "low"
                  }
                },
                "required": ["ai_confidence_label"]
              },
              "then": {
                "required": ["ai_notes"],
                "properties": {
                  "ai_notes": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
