{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IDP Raw Line Transcription (on disk)",
  "description": "Saved *_raw.json after PaddleOCR line boxes (schema_version 2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lines", "confidence_score", "confidence_label"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2,
      "description": "Transcription JSON geometry revision"
    },
    "lines": {
      "type": "array",
      "description": "One object per visible text line in reading order",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page_number", "text", "line_box"],
        "properties": {
          "page_number": {
            "type": "integer",
            "minimum": 1,
            "description": "1-based page index within this chunk"
          },
          "text": {
            "type": "string",
            "description": "Transcription for this line"
          },
          "line_box": {
            "type": "object",
            "description": "Axis-aligned line region normalized 0-1000 (PaddleOCR-derived)",
            "additionalProperties": false,
            "required": ["ymin", "xmin", "ymax", "xmax"],
            "properties": {
              "ymin": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "xmin": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "ymax": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "xmax": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              }
            }
          },
          "ai_confidence_label": {
            "type": "string",
            "enum": ["low", "medium", "high"],
            "description": "AI per-line confidence level for triage"
          },
          "ai_notes": {
            "type": "string",
            "description": "AI per-line rationale for uncertainty; required when AI confidence is low"
          }
        }
      }
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Numeric confidence in the transcription (0.0 to 1.0)"
    },
    "confidence_label": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "description": "Human-readable confidence level"
    },
    "model": {
      "type": "string",
      "description": "LiteLLM model id used for Pass 1 (stored in saved *_raw.json by transcribe-chunk.py)"
    },
    "configuration": {
      "type": "string",
      "description": "Summary of transcription settings (stored in saved *_raw.json by transcribe-chunk.py)"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lines": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {
                "ai_confidence_label": {
                  "const": "low"
                }
              },
              "required": ["ai_confidence_label"]
            }
          }
        }
      },
      "then": {
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "if": {
                "properties": {
                  "ai_confidence_label": {
                    "const": "low"
                  }
                },
                "required": ["ai_confidence_label"]
              },
              "then": {
                "required": ["ai_notes"],
                "properties": {
                  "ai_notes": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
